# ==============================================================================
# MediAI Platform - Environment Variables Template
# Copy this file to .env and populate with your own credentials.
# NEVER commit real credentials, tokens, or DSNs to version control.
# ==============================================================================

# --- Database & Auth ---
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
SECRET_KEY=your-super-secret-jwt-key-min-32-chars-long

# --- AI & Cloud Services ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
HF_TOKEN=hf_your_huggingface_user_access_token

# --- Communication ---
RESEND_API_KEY=re_your_resend_api_key

# --- MLOps & Observability (Phase 1) ---
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
APP_VERSION=1.0.0
APP_ENV=development

# --- RAG Cache Configurations (Phases 4 & 5) ---
BM25_CACHE_MAX_SIZE=200
SEMANTIC_CACHE_THRESHOLD=0.97
SEMANTIC_CACHE_TTL_SEC=3600

